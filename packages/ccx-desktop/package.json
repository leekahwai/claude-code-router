{
  "name": "@ccx/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron main-process surface for the Work/Code product: window, preload, IPC namespace.",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@ccx/harness": "0.1.0"
  },
  "scripts": {
    "test": "node ../ccx-vendor/tools/run-ccx-tests.mjs \"test/**/*.test.ts\"",
    "build:app": "node tools/build-app.mjs",
    "test:electron": "node tools/build-app.mjs && node tools/electron-smoke.mjs"
  }
}
